# Copy to .env; never commit real credentials.
JOJO_PROVIDER=gemini
GEMINI_API_KEY=
# Alternatives: JOJO_PROVIDER=openai or anthropic, with your own model ID.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
JOJO_MODEL=gemini-3.5-flash-lite
# Optional: comma separated keys instead of GEMINI_API_KEY
# GEMINI_API_KEYS=key-one,key-two
# Default Windows input device is used unless selected in the desktop app.
# Optional remote access: keep loopback unless you deliberately need LAN access.
JOJO_HOST=127.0.0.1
# Shared phone/laptop Firestore memory namespace (credentials remain on laptop).
JOJO_MEMORY_NAMESPACE=primary
# Optional explicit private service-account path; never place credentials in Git.
# JOJO_FIREBASE_CREDENTIALS=C:/private/your-firebase.json
# Optional, manually paired smart-home bridge. Keep real token only in .env.
# JOJO_HA_URL=http://192.168.1.10:8123
# JOJO_HA_TOKEN=your-home-assistant-token
# JOJO_HA_ENTITIES=light.bedroom,fan.study,switch.desk
